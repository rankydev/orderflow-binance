# Kopieren nach .env (nicht einchecken). Werte für die lokale Entwicklungs-DB.
# docker compose und die Node-Werkzeuge lesen dieselbe Datei.
OF_DB_HOST=127.0.0.1
OF_DB_PORT=54320
OF_DB_USER=of_admin
OF_DB_PASSWORD=bitte-lokal-aendern
OF_DB_NAME=orderflow

# Wurzel für Rohdaten/Spool (Standard: ./data, git-ignoriert)
OF_DATA_DIR=data
OF_LOG_LEVEL=info
