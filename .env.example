# Kopieren nach .env (nicht einchecken). Werte für die lokale Entwicklungs-DB.
# docker compose und die Node-Werkzeuge lesen dieselbe Datei.
OF_DB_HOST=127.0.0.1
OF_DB_PORT=54320
OF_DB_USER=of_admin
OF_DB_PASSWORD=bitte-lokal-aendern
OF_DB_NAME=orderflow

# Wurzel für Rohdaten/Spool (Standard: ./data, git-ignoriert)
OF_DATA_DIR=data
OF_LOG_LEVEL=info

# API (apps/api): nur lesende Rolle of_api (Migration 0009). Passwort setzen mit
#   npm run role:password -w @orderflow/api   (als OF_DB_USER, aus OF_API_DB_PASSWORD)
OF_API_DB_USER=of_api
OF_API_DB_PASSWORD=bitte-lokal-aendern-mind-16-zeichen
# Optional (Standardwerte): Bindung nur Loopback, Port, CORS-Ursprünge (loopback | * | Liste),
# Pool, Warteschlange, Zeitgrenzen, Cache, Grenzen nach KONZEPT §1.4
# OF_API_HOST=127.0.0.1
# OF_API_PORT=8780
# OF_API_CORS_ORIGINS=loopback
# OF_API_DB_POOL=4
# OF_API_MAX_QUEUE=64
# OF_API_STATEMENT_TIMEOUT_MS=5000
# OF_API_LOCK_TIMEOUT_MS=1000
# OF_API_LOCK_RETRIES=3
# OF_API_CACHE_MB=200
# OF_API_POLL_MS=1000
# OF_API_MAX_SOURCE_ROWS=1500000
# OF_API_MAX_CELLS=60000
